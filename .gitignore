# IDE folders
.idea/
.vs/

# Caches
__pycache__
.mypy_cache
.cache/

# Build files
build/
.ninja_*
build.ninja

# Generated configs
compile_commands.json

# The January build and the Xbox SDK (tools/xdk_headers.py reads the
# build's PDB); never commit
*.exe
*.pdb
xbox/
!source/**/xbox/
!port/xbox/

