# make writes beside the sources
port/xbox/xemu.local.toml
port/xbox/**/bin/
port/xbox/**/*.obj
port/xbox/**/*.d
port/xbox/**/*.iso
port/xbox/**/*.lib
port/xbox/**/*.exe.manifest

# Locally extracted proprietary game data (never commit)
assets/
# (but the high-res assets, drawn for the port: tools/hud_assets.py)
!port/assets/
original/

# CI build outputs (tools/ci_build.py)
dist/
